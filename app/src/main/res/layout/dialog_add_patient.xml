

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register New Patient"
            android:textColor="#102D53"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <EditText
            android:id="@+id/input_patient_id"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Patient ID (e.g. UHC501)"
            android:inputType="textCapCharacters"
            android:singleLine="true" />

        <EditText
            android:id="@+id/input_patient_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Full name"
            android:inputType="textPersonName"
            android:singleLine="true" />

        <EditText
            android:id="@+id/input_patient_age"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Age"
            android:inputType="number"
            android:singleLine="true" />

        <EditText
            android:id="@+id/input_patient_gender"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Gender (Male/Female)"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <EditText
            android:id="@+id/input_patient_blood_group"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Blood group (e.g. O+)"
            android:inputType="textCapCharacters"
            android:singleLine="true" />

        <EditText
            android:id="@+id/input_patient_bed"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Bed number (e.g. Ward 1 - Bed 10)"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <EditText
            android:id="@+id/input_patient_history"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top"
            android:hint="Medical history"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <EditText
            android:id="@+id/input_patient_allergies"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="top"
            android:hint="Allergies (enter None if unknown or none reported)"
            android:inputType="textMultiLine"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
